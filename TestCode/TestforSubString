public Instruction handleSubString1(JVMInvokeInstruction invInst, ThreadInfo th) {
    StackFrame sf = th.getModifiableTopFrame();
    IntegerExpression sym_v1 = (IntegerExpression) sf.getOperandAttr(0);
    StringExpression sym_v2 = (StringExpression) sf.getOperandAttr(1);

    if ((sym_v1 == null) & (sym_v2 == null)) {
        throw new RuntimeException("ERROR: symbolic string method must have one symbolic operand: HandleSubString1");
    } else {
        ChoiceGenerator<?> cg;
        int currentChocie = 0;

        cg = th.getVM().getChoiceGenerator();
        assert (cg instanceof PCChoiceGenerator) : "expected PCChoiceGenerator, got: " + cg;
        currentChocie = (Integer) cg.getNextChoice();

        int s1 = sf.pop();
        int s2 = sf.pop();
        PathCondition pc1;
        PathCondition pc2;

        ChoiceGenerator<?> prev_cg = cg.getPreviousChoiceGenerator();
        while (!((prev_cg == null) || (prev_cg instanceof PCChoiceGenerator))) {
            prev_cg = prev_cg.getPreviousChoiceGenerator();
        }

        if (prev_cg == null) {
            pc1 = new PathCondition();
            pc2 = new PathCondition();
        } else {
            pc1 = ((PCChoiceGenerator) prev_cg).getCurrentPC();
            pc2 = ((PCChoiceGenerator) prev_cg).getCurrentPC();
        }

        assert pc1 != null;
        assert pc2 != null;

        if (currentChocie == 1) {
            StringExpression result = null;
            if (sym_v1 == null) { // operand 0 is concrete
                int val = s1;
                result = sym_v2._subString(val);
            } else {
                if (sym_v2 == null) {
                    ElementInfo e1 = th.getElementInfo(s2);
                    String val2 = e1.asString();
                    sym_v2 = new StringConstant(val2);
                    result = sym_v2._subString(sym_v1);
                } else {
                    result = sym_v2._subString(sym_v1);
                }
            }
            ElementInfo objRef = th.getHeap().newString("", th); /*
                                                                  * dummy
                                                                  * String
                                                                  * Object
                                                                  */
            sf.push(objRef.getObjectRef(), true);
            sf.setOperandAttr(result);
        } else {
            if (!rte_flag) {
                th.getVM().getSystemState().setIgnored(true);
            } else {
                if (sym_v2 != null) { // means the String is symbolic
                    if (sym_v1 != null) { // means the string and the beginIndex both are symbolic
                        pc1._addDet(Comparator.LT, sym_v1, new IntegerConstant(0));
                        pc2._addDet(Comparator.GT, sym_v1, sym_v2._length());
                    } else { // means the beginIndex passed to subString() is concrete, but string is
                             // smybolic
                        int val = s1;
                        if (val < 0) {
                            th.createAndThrowException("java.lang.StringIndexOutOfBoundsException",
                                    "String index out of range: " + val + " (Concrete beginIndex)");
                        } else {
                            pc2._addDet(Comparator.GT, val, sym_v2._length());
                        }
                    }
                } else {
                    ElementInfo e1 = th.getElementInfo(s2);
                    String val2 = e1.asString();
                    sym_v2 = new StringConstant(val2);// string is not symbolic
                    pc1._addDet(Comparator.LT, sym_v1, new IntegerConstant(0));
                    pc2._addDet(Comparator.GT, sym_v1, sym_v2._length());
                }
                if (!pc1.simplify() || !pc2.simplify()) {
                    // This path is not satisfiable - ignore it
                    th.getVM().getSystemState().setIgnored(true);
                } else {
                    // String can be short enough to cause exception
                    th.createAndThrowException("java.lang.StringIndexOutOfBoundsException");
                }
            }
        }
    }
    return null;
}